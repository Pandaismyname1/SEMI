{
  "schemaVersion": 1,
  "id": "emi",
  "version": "${version}",
  "name": "SEMI",
  "description": "Seasonal EMI, an unofficial continuation of EMI: a featureful and accessible item and recipe viewer",
  "authors": [
    "Emi"
  ],
  "contributors": [
    "Pandaismyname1",
    "link-fgfgui"
  ],
  "contact": {
    "homepage": "https://github.com/Pandaismyname1/SEMI",
    "sources": "https://github.com/Pandaismyname1/SEMI",
    "issues": "https://github.com/Pandaismyname1/SEMI/issues"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.emi.emi.platform.fabric.EmiMainFabric"
    ],
    "client": [
      "dev.emi.emi.platform.fabric.EmiClientFabric"
    ],
    "server": [],
    "emi": [
      "dev.emi.emi.VanillaPlugin"
    ],
    "modmenu": [
      "dev.emi.emi.compat.EmiModMenu"
    ],
    "jei_mod_plugin": [
      "dev.emi.emi.jemi.JemiPlugin"
    ]
  },
  "custom": {
    "polymer:disable_mixin": {
      "polymer-core:client.compat.emi_ItemEmiStackMixin": "Please stop mixing into impl"
    }
  },
  "mixins": [
    "emi.mixins.json",
    "emi-fabric.mixins.json"
  ],
  "accessWidener": "emi.accesswidener",
  "depends": {
    "minecraft": "~26.2-",
    "java": ">=25",
    "fabricloader": ">=0.18.4",
    "fabric-api": "*"
  }
}
